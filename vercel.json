{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ],
  "functions": {
    "api/analyze.js": {"maxDuration": 120},
    "api/analyze-v2.js": {"maxDuration": 120},
    "api/contact.js": {"maxDuration": 60},
    "api/discover.js": {"maxDuration": 120},
    "api/discover-clients.js": {"maxDuration": 120},
    "api/discover-v2.js": {"maxDuration": 120},
    "api/diagnostics.js": {"maxDuration": 30},
    "api/health.js": {"maxDuration": 15},
    "api/version.js": {"maxDuration": 10}
  }
}