{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/api/email/status", "destination": "/api/gmail?action=status"},
    {"source": "/api/email/auth-start", "destination": "/api/gmail?action=auth"},
    {"source": "/api/email/send", "destination": "/api/gmail"},
    {"source": "/api/discover-clients", "destination": "/api/discover"},
    {"source": "/api/discover-v2", "destination": "/api/discover"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ],
  "functions": {
    "api/analyze.js": {"maxDuration": 120},
    "api/discover.js": {"maxDuration": 120},
    "api/hunt.js": {"maxDuration": 45},
    "api/bcww.js": {"maxDuration": 120},
    "api/wsce.js": {"maxDuration": 120},
    "api/kbeauty.js": {"maxDuration": 120},
    "api/education-fair.js": {"maxDuration": 120},
    "api/contact.js": {"maxDuration": 120},
    "api/find-contacts.js": {"maxDuration": 120},
    "api/deleted.js": {"maxDuration": 30},
    "api/health.js": {"maxDuration": 15}
  }
}